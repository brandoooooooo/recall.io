{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
        "providers": ["...", "python"],
        
        "phases":{
          "setup": {
            "nixPkgs": ["...", "nodejs"]
          }
        },
        "python_version": "3.12"
    }
  },
  "env": {
    "PYTHONPATH": "/app",
    "ALEMBIC_CONFIG": "/app/alembic.ini"
  },
  "deploy": {
    "startCommand": "poetry install && poetry run alembic -c app/alembic.ini upgrade head && poetry run gunicorn -b 0.0.0.0:8000 app:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}